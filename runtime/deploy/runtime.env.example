# /etc/vultr-runtime/runtime.env  (root:root 0600)
# Contains no secrets: API keys live hashed in /etc/vultr-runtime/api_keys.json,
# the proxy HMAC key in /etc/vultr-runtime/proxy_hmac.key.

# Listen address. Keep loopback unless the core benchmark has passed;
# the controller refuses a non-loopback bind otherwise.
RUNTIME_BIND=127.0.0.1
RUNTIME_PORT=8001

RUNTIME_DATA_DIR=/var/lib/vultr-runtime
RUNTIME_CONFIG_DIR=/etc/vultr-runtime
RUNTIME_SANDBOX_IMAGE=vultr-runtime-sandbox:latest
RUNTIME_PROXY_IMAGE=vultr-runtime-egress-proxy:latest

# gVisor is required. Set RUNTIME_ALLOW_RUNC_FALLBACK=1 only to accept weaker isolation.
RUNTIME_OCI_RUNTIME=runsc
RUNTIME_ALLOW_RUNC_FALLBACK=0

RUNTIME_MAX_CONCURRENCY=4
RUNTIME_MAX_QUEUE=50
RUNTIME_MAX_ACTIVE_PER_PRINCIPAL=6
RUNTIME_JOB_TTL_HOURS=24

# Operator-pinned internal destinations that networked jobs may reach when
# their policy sets allow_trusted_targets (ip:port, comma separated).
# Example: the team's demo shop on this host.
RUNTIME_TRUSTED_TARGETS=70.34.217.56:8080

# Domain allowlist applied to the backend compatibility endpoints (/run, /screenshot).
# "*" = any public host (private/host/metadata addresses are always blocked).
RUNTIME_COMPAT_ALLOWED_DOMAINS=*

RUNTIME_FIREWALL_SCRIPT=/opt/vultr-runtime/deploy/firewall.sh
